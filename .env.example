# .env.example - Interactive Brokers Trading System Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# Interactive Brokers Connection
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENTID=1
IB_ACCOUNT=

# Trading Mode (7497 = paper/demo TWS; 7496 = live)
PAPER_TRADING=True
ENABLE_LIVE_TRADING=False

# Paper learning (demo only — omitted vars get faster-learning defaults when PAPER_TRADING=True)
PAPER_LEARNING_MODE=True
# PAPER_LEARNING_MODE=False
# MAX_POSITION_SIZE=500
# MAX_DAILY_TRADES=5
# TRADING_LOOP_MINUTES=3
# MIN_BUY_SIGNALS_FOR_ENTRY=2
# REQUIRE_BULLISH_NEWS_FOR_BUY=False

# Account Settings
STARTER_ACCOUNT_MODE=True
STARTER_ACCOUNT_CAPITAL=2000
MAX_DAILY_LOSS=40
MAX_POSITION_SIZE=100
POSITION_SIZE_PERCENT=0.05
MAX_PORTFOLIO_POSITION_PERCENT=0.05
MAX_OPEN_POSITIONS=1
REQUIRE_SETTLED_CASH_FOR_BUYS=True
STOP_LOSS_PERCENT=1.25
TAKE_PROFIT_PERCENT=0.75
MAX_DAILY_TRADES=1
EARNINGS_BLACKOUT_DAYS_BEFORE=3
EARNINGS_BLACKOUT_DAYS_AFTER=1
DIVIDEND_BLACKOUT_DAYS_BEFORE=1
DIVIDEND_BLACKOUT_DAYS_AFTER=0

# Market/news safety
NEWS_REFRESH_MINUTES=15
REQUIRE_NEWS_CHECK=True
BLOCK_ON_NEWS_FAILURE=True
TRADE_FREE_US_STOCKS_ONLY=True
REQUIRE_BULLISH_NEWS_FOR_BUY=True
WATCHLIST_METHOD=news_trending
MAX_WATCHLIST_SIZE=8
REGULAR_HOURS_BUFFER_MINUTES=5
USE_AI_INFRA_UNIVERSE=True
MIN_BUY_VOLUME_RATIO=1.1
MIN_BUY_1D_CHANGE=0.0025
MIN_BUY_5D_CHANGE=0.01
MIN_PRICE=10
MAX_PRICE=120
STARTER_MAX_PRICE=120
STARTER_MIN_MARKET_CAP=5000000000
REQUIRE_MARKET_REGIME_CONFIRMATION=True
MARKET_REGIME_SYMBOLS=SPY,QQQ
MAX_ENTRY_SLIPPAGE_PERCENT=0.10
MAX_EXIT_SLIPPAGE_PERCENT=0.15
USE_LIMIT_ORDERS_ONLY=True
ALLOWED_US_STOCKS=AAPL,MSFT,NVDA,AMZN,GOOGL,META,TSLA,AVGO,AMD,NFLX,CRM,ORCL,COST,ADBE,NOW,PANW,CRWD,MU,QCOM,INTC,SHOP,UBER,ABNB,PLTR,JPM,BAC,WFC,GS,MS,V,MA,AXP,PYPL,LLY,UNH,JNJ,ABBV,MRK,PFE,TMO,ISRG,XOM,CVX,CAT,GE,BA,DE,WMT,HD,MRVL,ANET,VRT,DELL,SMCI,WDC,STX,LRCX,AMAT,KLAC,TER,LITE,COHR,CIEN,ETN,PWR,CEG,ADI,TXN,MPWR,ON
AI_INFRA_STOCKS=NVDA,AMD,AVGO,MU,MRVL,QCOM,ANET,VRT,DELL,SMCI,WDC,STX,LRCX,AMAT,KLAC,TER,LITE,COHR,CIEN,ETN,PWR,CEG,GOOGL,MSFT,AMZN,META,ORCL,ADI,TXN,MPWR,ON,INTC
STARTER_STOCKS=INTC,HPE,BAC,WFC,CSCO,PFE,KO,T,VZ,F,GM,UBER,PYPL,ON,HPQ
EXCLUDED_EVENT_SENSITIVE_STOCKS=XOM,CVX,OXY,COP,SLB,HAL,USO

# Email Alerts (Optional)
ENABLE_EMAIL_ALERTS=False
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# Slack Alerts (Optional)
ENABLE_SLACK_ALERTS=False
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
